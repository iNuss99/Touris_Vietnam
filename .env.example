# Cổng chạy API Backend
PORT=5000

# Chuỗi kết nối đến Neon PostgreSQL Database
# Ví dụ: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://<YOUR_NEON_USER>:<YOUR_NEON_PASSWORD>@<YOUR_NEON_HOST>/neondb?sslmode=require&channel_binding=require

# Secret key cho JSON Web Token (Bắt buộc)
JWT_SECRET=
